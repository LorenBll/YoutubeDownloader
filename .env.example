# YoutubeDownloader Configuration
# Copy this file to .env and fill in the values for your environment.

# Task retention in minutes before finished tasks are cleaned up.
# TASK_RETENTION_MINUTES=30

# Interval in seconds between cleanup cycles.
# TASK_CLEANUP_INTERVAL_SECONDS=60

# Path to ffmpeg executable (optional, auto-detected from PATH if not set).
# FFMPEG_PATH=
